<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirection transparente des requêtes backend vers le dossier public de Laravel
    RewriteCond %{REQUEST_URI} ^/backend/(.*)$
    RewriteRule ^backend/(.*)$ backend/public/$1 [L]

    # 2. Gestion du routage d'URL Flutter Web (Fallback index.html)
    # Si le fichier ou dossier demandé n'existe pas physiquement, et n'est pas le backend
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/backend/
    RewriteRule ^(.*)$ index.html [L]
</IfModule>
